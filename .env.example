# Copy this file to ".env" and fill in what you use.
# .env is in .gitignore, so it never goes to GitHub.

# DA7016 OpenRouter key (starts with sk-or-...)
OPENROUTER_API_KEY=

# Bodhan AI key (Indic OCR / translation), same email as the course
BODHAN_API_KEY=

# Optional: start with this profile (mock, local, ollama_cloud, ollama_api,
# openrouter, openrouter_lite, openrouter_gpt)
AUTOGRADER_PROFILE=

# Optional: public demo limits, and a login for the web app
AUTOGRADER_PUBLIC=
AUTOGRADER_USER=
AUTOGRADER_PASSWORD=

# Ollama cloud models without installing Ollama (ollama.com/settings/keys)
OLLAMA_API_KEY=

# Optional: only change if Ollama runs somewhere else
OLLAMA_BASE_URL=http://localhost:11434/v1
